<header class="app-topbar">
  <div class="app-topbar__inner">
    <div class="app-topbar__heading">
      <p class="app-topbar__company">Зёрна · демо</p>
      <h1 class="app-topbar__title"><%= pageTitle %></h1>
    </div>

    <div class="app-topbar__tools">
      <p class="app-topbar__anchor">Данные по <%= dataAnchor %></p>

      <%#
        Plain GET form, no inline handler: the CSP forbids script attributes. `preserve` replays every other query
        key (channel filter, sort) so switching the period cannot silently reset the screen.
      %>
      <% if (locals.periodControl && periodControl.customRange) { %>
      <%# An explicit from/to range has no matching select option; label the real window instead of a false "30 дней". %>
      <p class="app-topbar__range">
        Период: <strong><%= periodControl.customRange.label %></strong>
        <a class="app-topbar__range-reset" href="<%= periodControl.customRange.href %>">30 дней</a>
      </p>
      <% } else if (locals.periodControl) { %>
      <form class="app-topbar__period" method="get" action="<%= locals.currentPath || '/app/dashboard' %>">
        <% for (const item of periodControl.preserve) { %>
        <input type="hidden" name="<%= item.name %>" value="<%= item.value %>">
        <% } %>
        <label class="app-topbar__period-field">
          <span class="u-visually-hidden">Период расчётов</span>
          <select class="select app-topbar__select" name="days">
            <% for (const option of periodControl.options) { %>
            <option value="<%= option.value %>"<%= option.selected ? ' selected' : '' %>><%= option.label %></option>
            <% } %>
          </select>
        </label>
        <button class="btn btn--ghost btn--sm" type="submit">Показать</button>
      </form>
      <% } %>

      <a class="app-avatar" href="/app/profile" aria-label="Профиль: <%= currentUser.fullName %>"><%= initials %></a>
    </div>
  </div>
</header>
