<%
  // One class helper keeps every item consistent: the active state is a cyan left bar plus ink text, and the
  // `aria-current` attribute is the accessible twin of that visual state.
  const linkClass = (key) => (activeNav === key ? 'app-nav__link is-active' : 'app-nav__link');
  const current = (key) => (activeNav === key ? ' aria-current="page"' : '');
%>
<aside class="app-sidebar">
  <%# A checkbox drives the mobile collapse with CSS only; on desktop it is hidden and the navigation is always shown.
       Its accessible name comes from the visible "Разделы" label, and the checked state tells a screen reader whether
       the list is open; a fixed aria-label would announce "Показать" even when it is already open. %>
  <input class="app-nav-toggle" type="checkbox" id="app-nav-toggle">

  <div class="app-sidebar__head">
    <a class="app-sidebar__brand" href="/app/dashboard">
      <img src="/img/logo.svg" alt="" width="28" height="28">
      <span>Метрика</span>
    </a>
    <label class="app-nav__toggle" for="app-nav-toggle">Разделы</label>
  </div>

  <nav class="app-nav" aria-label="Разделы приложения">
    <div class="app-nav__group">
      <p class="app-nav__title">Аналитика</p>
      <ul class="app-nav__list">
        <li><a class="<%= linkClass('dashboard') %>" href="/app/dashboard"<%= current('dashboard') %>>Дашборд</a></li>
        <% if (can('channels:view')) { %>
        <li><a class="<%= linkClass('channels') %>" href="/app/channels"<%= current('channels') %>>Каналы</a></li>
        <% } %>
        <% if (can('campaigns:view')) { %>
        <li><a class="<%= linkClass('campaigns') %>" href="/app/campaigns"<%= current('campaigns') %>>Кампании</a></li>
        <% } %>
        <% if (can('cohorts:view')) { %>
        <li><a class="<%= linkClass('cohorts') %>" href="/app/cohorts"<%= current('cohorts') %>>Когорты</a></li>
        <% } %>
        <% if (can('attribution:view')) { %>
        <li><a class="<%= linkClass('attribution') %>" href="/app/attribution"<%= current('attribution') %>>Атрибуция</a></li>
        <% } %>
      </ul>
    </div>

    <div class="app-nav__group">
      <p class="app-nav__title">Решения</p>
      <ul class="app-nav__list">
        <% if (can('scenarios:view')) { %>
        <li><a class="<%= linkClass('scenarios') %>" href="/app/scenarios"<%= current('scenarios') %>>Сценарии</a></li>
        <% } %>
        <% if (can('alerts:view')) { %>
        <li><a class="<%= linkClass('alerts') %>" href="/app/alerts"<%= current('alerts') %>>Алерты</a></li>
        <% } %>
        <% if (can('goals:view')) { %>
        <li><a class="<%= linkClass('goals') %>" href="/app/goals"<%= current('goals') %>>Цели</a></li>
        <% } %>
      </ul>
    </div>

    <% if (can('import:run') || can('audit:view')) { %>
    <div class="app-nav__group">
      <p class="app-nav__title">Данные</p>
      <ul class="app-nav__list">
        <% if (can('import:run')) { %>
        <li><a class="<%= linkClass('import') %>" href="/app/import"<%= current('import') %>>Импорт</a></li>
        <% } %>
        <% if (can('audit:view')) { %>
        <li><a class="<%= linkClass('audit') %>" href="/app/audit"<%= current('audit') %>>Аудит</a></li>
        <% } %>
      </ul>
    </div>
    <% } %>

    <% if (can('users:manage')) { %>
    <div class="app-nav__group">
      <p class="app-nav__title">Администрирование</p>
      <ul class="app-nav__list">
        <li><a class="<%= linkClass('users') %>" href="/app/admin/users"<%= current('users') %>>Пользователи</a></li>
      </ul>
    </div>
    <% } %>
  </nav>

  <div class="app-sidebar__footer">
    <a class="app-sidebar__user" href="/app/profile">
      <span class="app-sidebar__user-name"><%= currentUser.fullName %></span>
      <span class="app-sidebar__user-role"><%= roleLabel %></span>
    </a>
    <form class="app-sidebar__logout" method="post" action="/logout">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn btn--ghost btn--sm" type="submit">Выйти</button>
    </form>
  </div>
</aside>
