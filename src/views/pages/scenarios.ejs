<%#
  Scenarios builder frame. The GET form recalculates from the URL, the save form posts the selected inputs with CSRF,
  and the island renders the resulting model — the same object `/api/v1/scenarios` returns. Saved snapshots are listed
  below with links to their detail pages.
%>
<section class="app-section">
  <div class="stack stack--lg">
    <div class="stack stack--sm">
      <h2>Сценарии бюджета</h2>
      <p class="u-muted">
        Сценарий распределяет недельный бюджет между платными каналами по кривым насыщения. Расчёт опирается на
        <%= model.history.weeks %> полных недель, а сохранённый снимок не меняется задним числом. Суммы — в BYN, за
        12 месяцев бюджет умножается на <%= model.weeksPerYear %>. Итог «Сейчас» включает все выбранные каналы, а
        потолок и предупреждение считаются от базы оптимизации — текущего расхода каналов с кривой.
      </p>
    </div>

    <% if (model.unavailable) { %>
    <div class="card card--flat">
      <div class="card__header">
        <div>
          <h3 class="card__title">Пока нечего распределять</h3>
          <p class="card__meta">Для кривой нужно достаточно недель с расходом и новыми клиентами.</p>
        </div>
      </div>
      <div class="empty-state">
        <p class="empty-state__title">Нет данных для расчёта сценария</p>
        <p class="empty-state__text"><%= model.error %></p>
        <p class="empty-state__text">
          Нужны минимум 8 недель с расходом и новыми клиентами по каналу. Загрузите статистику и новые заказы —
          после этого появятся кривые, план и прогноз.
        </p>
        <% if (can('import:run')) { %>
        <a class="btn btn--primary btn--sm" href="/app/import">Перейти к импорту</a>
        <% } %>
      </div>
    </div>
    <% } else { %>

    <% if (model.builderError) { %>
    <div class="alert alert--error" role="alert">
      <p class="alert__title">Расчёт не выполнен</p>
      <p><%= model.error %></p>
      <% if (model.controls.budgetEntry) { %>
      <p class="field__hint">Введённый бюджет: <strong><%= model.controls.budgetEntry %></strong></p>
      <% } %>
      <p class="field__hint">Исправьте параметры ниже и нажмите «Рассчитать».</p>
    </div>
    <% } %>

    <div class="card card--flat">
      <div class="card__header">
        <div>
          <h3 class="card__title">Параметры расчёта</h3>
          <% if (model.budget) { %>
          <p class="card__meta">
            Недельный бюджет: <strong class="u-numeric"><%= model.budget.weeklyLabel %> <span class="byn">BYN</span></strong>
            · за 12 месяцев: <strong class="u-numeric"><%= model.budget.forecast12mLabel %> <span class="byn">BYN</span></strong>
          </p>
          <% } else { %>
          <p class="card__meta">Проверьте бюджет и набор каналов — сервер пересчитает план.</p>
          <% } %>
        </div>
      </div>

      <form class="inline-form" method="get" action="/app/scenarios" aria-label="Параметры сценария">
        <div class="field">
          <label class="field__label" for="budgetByn">Недельный бюджет</label>
          <% if (model.builderError) { %>
          <input
            class="input"
            id="budgetByn"
            type="<%= model.controls.budgetInputType %>"
            inputmode="decimal"
            name="budgetByn"
            value="<%= model.controls.budgetEntry %>"
            min="<%= model.controls.budgetMinInput %>"
            max="<%= model.controls.budgetMaxInput %>"
            step="0.01"
            aria-describedby="budget-hint"
            required
          >
          <span class="field__hint" id="budget-hint">
            Допустимый недельный бюджет: от <span class="u-numeric"><%= model.controls.budgetMinLabel %></span>
            <span class="byn">BYN</span> до <span class="u-numeric"><%= model.controls.budgetMaxLabel %></span>
            <span class="byn">BYN</span>. Введённое значение не подменяется — исправьте его или выберите пресет
            ниже.
          </span>
          <% } else { %>
          <input
            class="range"
            id="budgetByn"
            type="range"
            name="budgetByn"
            value="<%= model.controls.budgetInput %>"
            min="<%= model.budget.minInput %>"
            max="<%= model.budget.capInput %>"
            step="0.01"
            aria-describedby="budget-hint"
            required
          >
          <span class="field__hint" id="budget-hint">
            <strong class="u-numeric"><%= model.budget.weeklyLabel %> <span class="byn">BYN</span></strong>
            · за 12 месяцев ×<%= model.budget.weeksPerYear %>: <strong class="u-numeric"><%= model.budget.forecast12mLabel %> <span class="byn">BYN</span></strong>
            · база оптимизации: <strong class="u-numeric"><%= model.budget.baselineLabel %> <span class="byn">BYN</span></strong>
            · минимум: <span class="u-numeric"><%= model.budget.minLabel %></span> <span class="byn">BYN</span>
            (по 1 копейке на канал с кривой)
            · максимум: <strong class="u-numeric"><%= model.budget.capLabel %></strong> <span class="byn">BYN</span>
            — <%= model.budget.maxMultiplier %>× базы оптимизации
          </span>
          <% } %>
          <div class="cluster" aria-label="Пресеты недельного бюджета">
            <% for (const preset of model.controls.presets) { %>
            <a
              class="btn btn--ghost btn--sm"
              href="<%= preset.href %>"
              <%= preset.active ? 'aria-current="true"' : '' %>
            ><%= preset.label %></a>
            <% } %>
          </div>
        </div>

        <fieldset class="field">
          <legend class="field__label">Каналы</legend>
          <% for (const channel of model.controls.channels) { %>
          <label class="cluster">
            <input type="checkbox" name="channelIds" value="<%= channel.value %>"<%= channel.selected ? ' checked' : '' %>>
            <span><%= channel.label %></span>
          </label>
          <% } %>
        </fieldset>

        <label class="field">
          <span class="field__label">Канал кривой</span>
          <select class="select" name="curveChannelId">
            <% for (const channel of model.controls.curveOptions) { %>
            <option value="<%= channel.value %>"<%= channel.value === model.controls.curveChannelId ? ' selected' : '' %>><%= channel.label %></option>
            <% } %>
          </select>
          <span class="field__hint">По умолчанию — первая доступная кривая насыщения.</span>
          <% if (model.controls.curveNote) { %>
          <span class="field__hint" role="status"><%= model.controls.curveNote %></span>
          <% } %>
        </label>

        <div class="cluster">
          <button class="btn btn--primary" type="submit">Рассчитать</button>
          <a class="btn btn--ghost" href="/app/scenarios">Сбросить</a>
        </div>
      </form>
    </div>

    <% if (!model.builderError) { %>
    <%- include('../partials/island', { name: 'scenarios', model }) %>

    <% if (can('scenarios:manage')) { %>
    <div class="card card--flat">
      <div class="card__header">
        <div>
          <h3 class="card__title">Сохранить сценарий</h3>
          <p class="card__meta">Сервер пересчитает снимок из текущих параметров и запишет его в журнал действий.</p>
        </div>
      </div>

      <form class="inline-form" method="post" action="/app/scenarios">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="budgetByn" value="<%= model.controls.budgetInput %>">
        <% for (const channel of model.controls.selectedChannels) { %>
        <input type="hidden" name="channelIds" value="<%= channel.value %>">
        <% } %>

        <label class="field">
          <span class="field__label">Название</span>
          <input class="input" type="text" name="name" minlength="3" maxlength="120" required placeholder="Рост на 20 %">
          <span class="field__hint">От 3 до 120 символов</span>
        </label>

        <button class="btn btn--ghost" type="submit">Сохранить сценарий</button>
      </form>
    </div>
    <% } %>
    <% } %>
    <% } %>

    <div class="card card--flat">
      <div class="card__header">
        <div>
          <h3 class="card__title">Сохранённые сценарии</h3>
          <p class="card__meta">Всего: <%= model.list.total %></p>
        </div>
      </div>

      <% if (model.list.rows.length === 0) { %>
      <div class="empty-state">
        <p class="empty-state__title">Сценариев пока нет</p>
        <p class="empty-state__text">Рассчитайте бюджет и сохраните снимок — он останется неизменным для сравнения.</p>
      </div>
      <% } else { %>
      <div class="table-wrap" role="region" aria-label="Сохранённые сценарии" tabIndex="0">
        <table class="table">
          <caption class="u-visually-hidden">Сохранённые сценарии</caption>
          <thead>
            <tr>
              <th scope="col">Название</th>
              <th scope="col">Автор</th>
              <th scope="col">Создан</th>
              <th scope="col">Отчётная дата</th>
              <th scope="col" class="u-right">Бюджет</th>
              <th scope="col" class="u-right">Каналов</th>
            </tr>
          </thead>
          <tbody>
            <% for (const row of model.list.rows) { %>
            <tr>
              <th scope="row"><a href="<%= row.href %>"><%= row.name %></a></th>
              <td><%= row.authorLabel %></td>
              <td class="u-nowrap"><%= row.createdAtLabel %></td>
              <td class="u-nowrap"><%= row.anchorLabel ?? '—' %></td>
              <td class="u-right u-numeric u-nowrap">
                <% if (row.invalid) { %>—<% } else { %><%= row.budgetLabel %> <span class="byn">BYN</span><% } %>
              </td>
              <td class="u-right u-numeric"><%= row.channelCountLabel %></td>
            </tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <% if (model.list.shownLabel) { %>
      <p class="card__meta"><%= model.list.shownLabel %></p>
      <% } %>
      <% if (model.list.prevHref || model.list.nextHref) { %>
      <nav class="cluster" aria-label="Страницы сохранённых сценариев">
        <% if (model.list.prevHref) { %>
        <a class="btn btn--ghost btn--sm" href="<%= model.list.prevHref %>">Назад</a>
        <% } %>
        <span class="u-muted">Страница <%= model.list.page %></span>
        <% if (model.list.nextHref) { %>
        <a class="btn btn--ghost btn--sm" href="<%= model.list.nextHref %>">Дальше</a>
        <% } %>
      </nav>
      <% } %>
      <% } %>

    </div>
  </div>
</section>
