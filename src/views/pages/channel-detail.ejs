<section class="app-section">
  <div class="stack stack--lg">
    <div class="cluster">
      <a class="btn btn--ghost btn--sm" href="/app/channels">К списку каналов</a>
    </div>

    <div class="cluster">
      <h2><%= channel.name %></h2>
      <span class="badge <%= channel.isActive ? 'badge--healthy' : 'badge--neutral' %>">
        <%= channel.statusLabel %>
      </span>
    </div>

    <div class="grid grid--2">
      <div class="card card--flat stack">
        <div class="stack stack--sm">
          <h3 class="card__title">Паспорт канала</h3>
          <p class="card__meta">Код и тип определяют, как кампании и импорт связываются с каналом.</p>
        </div>

        <div class="table-wrap">
          <table class="table">
            <tbody>
              <tr>
                <th scope="row">Код</th>
                <td><span class="u-muted"><%= channel.code %></span></td>
              </tr>
              <tr>
                <th scope="row">Тип</th>
                <td><%= channel.kindLabel %></td>
              </tr>
              <tr>
                <th scope="row">Статус</th>
                <td><%= channel.statusLabel %></td>
              </tr>
              <tr>
                <th scope="row">Целевой CAC</th>
                <td class="u-right">
                  <% if (channel.targetCacLabel === null) { %>
                  <span class="u-muted">—</span>
                  <% } else { %>
                  <span class="u-nowrap"><%= channel.targetCacLabel %> <span class="byn">BYN</span></span>
                  <% } %>
                </td>
              </tr>
              <tr>
                <th scope="row">Целевой ROMI</th>
                <td class="u-right"><%= channel.targetRomiLabel %></td>
              </tr>
              <tr>
                <th scope="row">Активных кампаний</th>
                <td class="u-right"><%= channel.activeCampaignCount %></td>
              </tr>
              <tr>
                <th scope="row">Всего кампаний</th>
                <td class="u-right"><%= channel.campaignCount %></td>
              </tr>
              <tr>
                <th scope="row">Создан</th>
                <td class="u-right u-numeric"><%= channel.createdAtLabel %></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <div class="card card--flat stack">
        <% if (can('channels:manage')) { %>
        <div class="stack stack--sm">
          <h3 class="card__title">Настройки канала</h3>
          <p class="card__meta">Целевые значения показываются в отчётах рядом с фактом.</p>
        </div>

        <% if (formError) { %>
        <div class="alert alert--error" role="alert">
          <p class="alert__title">Изменение не применено</p>
          <%= formError %>
        </div>
        <% } %>

        <form class="stack" method="post" action="/app/channels/<%= channel.id %>">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <label class="field">
            <span class="field__label">Название</span>
            <input
              class="input"
              type="text"
              name="name"
              value="<%= formValues.name %>"
              maxlength="100"
              autocomplete="off"
              required
            >
          </label>

          <label class="field">
            <span class="field__label">Тип</span>
            <select class="select" name="kind">
              <option value="paid" <%= formValues.kind === 'paid' ? 'selected' : '' %>>Платный</option>
              <option value="owned" <%= formValues.kind === 'owned' ? 'selected' : '' %>>Собственный</option>
              <option value="earned" <%= formValues.kind === 'earned' ? 'selected' : '' %>>Заработанный</option>
            </select>
          </label>

          <label class="field">
            <span class="field__label">Целевой CAC</span>
            <input
              class="input"
              type="text"
              name="targetCacByn"
              value="<%= formValues.targetCacByn %>"
              placeholder="38,50"
              inputmode="decimal"
              autocomplete="off"
            >
            <span class="field__hint">В белорусских рублях; пустое поле означает «цель не задана»</span>
          </label>

          <label class="field">
            <span class="field__label">Целевой ROMI</span>
            <input
              class="input"
              type="text"
              name="targetRomiPct"
              value="<%= formValues.targetRomiPct %>"
              placeholder="115"
              inputmode="decimal"
              autocomplete="off"
            >
            <span class="field__hint">В процентах, от 0 до 10 000</span>
          </label>

          <div class="cluster">
            <button class="btn btn--primary" type="submit">Сохранить</button>
          </div>
        </form>

        <div class="stack stack--sm">
          <h3 class="card__title">Архив</h3>
          <p class="card__meta">
            Архивный канал нельзя выбрать для новой кампании, но его история остаётся в отчётах. Канал с активными
            кампаниями архивировать нельзя: сначала остановите или завершите их.
          </p>
          <form method="post" action="/app/channels/<%= channel.id %>/archive">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn <%= channel.isActive ? 'btn--danger' : 'btn--ghost' %> btn--sm" type="submit">
              <%= channel.isActive ? 'Архивировать канал' : 'Вернуть из архива' %>
            </button>
          </form>
        </div>
        <% } else { %>
        <div class="stack stack--sm">
          <h3 class="card__title">Настройки канала</h3>
          <p class="u-muted">
            Менять название, тип и целевые значения могут аналитик и администратор. Паспорт канала доступен всем
            ролям.
          </p>
        </div>
        <% } %>
      </div>
    </div>

    <div class="card card--flat stack">
      <div class="card__header">
        <div>
          <h3 class="card__title">Кампании канала</h3>
          <p class="card__meta">
            Бюджет — план в белорусских рублях, расход считается по загруженной статистике. Кампания остаётся в
            истории, даже когда она на паузе или завершена.
          </p>
        </div>
        <a class="btn btn--ghost btn--sm" href="/app/campaigns?channelId=<%= channel.id %>">Все кампании</a>
      </div>

      <% if (campaignCreateError) { %>
      <div class="alert alert--error" role="alert">
        <p class="alert__title">Кампания не создана</p>
        <%= campaignCreateError %>
      </div>
      <% } %>

      <% if (channelCampaigns.length === 0) { %>
      <div class="empty-state">
        <p class="empty-state__title">У канала ещё нет кампаний</p>
        <p class="empty-state__text">
          Добавьте кампанию — и статистика, заказы и точки касания начнут связываться с этим каналом.
        </p>
      </div>
      <% } else { %>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th scope="col">Кампания</th>
              <th scope="col">Статус</th>
              <th scope="col">Старт</th>
              <th scope="col">Окончание</th>
              <th scope="col" class="u-right">Бюджет</th>
              <th scope="col" class="u-right">Расход</th>
              <th scope="col"><span class="u-visually-hidden">Действия</span></th>
            </tr>
          </thead>
          <tbody>
            <% channelCampaigns.forEach((campaign) => { %>
            <tr>
              <td>
                <%= campaign.name %>
                <span class="u-muted u-nowrap">· <%= campaign.code %></span>
              </td>
              <td><span class="badge badge--<%= campaign.statusTone %>"><%= campaign.statusLabel %></span></td>
              <td class="u-nowrap u-numeric"><%= campaign.startedOnLabel %></td>
              <td class="u-nowrap u-numeric"><%= campaign.endedOnLabel ?? '—' %></td>
              <td class="u-right u-nowrap">
                <% if (campaign.budgetLabel === null) { %>
                <span class="u-muted">—</span>
                <% } else { %>
                <%= campaign.budgetLabel %> <span class="byn">BYN</span>
                <% } %>
              </td>
              <td class="u-right u-nowrap">
                <% if (campaign.spendLabel === null) { %>
                <span class="u-muted">—</span>
                <% } else { %>
                <%= campaign.spendLabel %> <span class="byn">BYN</span>
                <% } %>
              </td>
              <td>
                <% if (can('campaigns:manage')) { %>
                <div class="row-actions">
                  <a class="btn btn--ghost btn--sm" href="/app/campaigns?edit=<%= campaign.id %>">Изменить</a>
                </div>
                <% } %>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>

      <% if (can('campaigns:manage') && channel.isActive) { %>
      <div class="stack stack--sm">
        <h4 class="card__title">Добавить кампанию</h4>
        <p class="card__meta">Канал уже выбран. Код кампании задаётся один раз и не меняется.</p>
      </div>

      <form class="inline-form" method="post" action="/app/campaigns">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="channelId" value="<%= channel.id %>">
        <input type="hidden" name="status" value="active">
        <input type="hidden" name="from" value="channel">

        <label class="field">
          <span class="field__label">Код</span>
          <input
            class="input"
            type="text"
            name="code"
            value="<%= campaignCreateValues.code %>"
            placeholder="instagram_spring"
            maxlength="60"
            autocomplete="off"
            required
          >
          <span class="field__hint">Строчные латинские буквы, цифры и подчёркивание</span>
        </label>

        <label class="field">
          <span class="field__label">Название</span>
          <input
            class="input"
            type="text"
            name="name"
            value="<%= campaignCreateValues.name %>"
            placeholder="Весенняя распродажа"
            maxlength="120"
            autocomplete="off"
            required
          >
        </label>

        <label class="field">
          <span class="field__label">Старт</span>
          <input
            class="input"
            type="date"
            name="startedOn"
            value="<%= campaignCreateValues.startedOn %>"
            required
          >
        </label>

        <label class="field">
          <span class="field__label">Бюджет</span>
          <input
            class="input"
            type="text"
            name="budgetByn"
            value="<%= campaignCreateValues.budgetByn %>"
            placeholder="1 500,00"
            inputmode="decimal"
            autocomplete="off"
          >
          <span class="field__hint">В белорусских рублях, можно оставить пустым</span>
        </label>

        <div class="cluster">
          <button class="btn btn--ghost" type="submit">Добавить кампанию</button>
        </div>
      </form>
      <% } else if (can('campaigns:manage')) { %>
      <p class="u-muted">
        Канал в архиве: новые кампании по нему создать нельзя. Верните канал из архива на карточке настроек.
      </p>
      <% } %>
    </div>
  </div>
</section>
