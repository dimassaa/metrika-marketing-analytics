<%#
  Channels frame. The page owns the shell, the M2 create form, the list filters, the CSV export and the weights form;
  the table, health badges, sparklines, score stack and ROMI bars are rendered by `client/entries/channels.jsx` from
  `model` — the same object `/api/v1/channels` returns.

  Every GET control replays the query parameters it does not change through hidden inputs. Changing the status must
  not silently reset the period, the sort order or custom weights, and changing the weights must not reset the M2
  filters. The export form is the exception: its schema knows only `status`/`kind`, so it sends exactly those.
%>
<section class="app-section">
  <div class="stack stack--lg">
    <div class="stack stack--sm">
      <h2>Каналы привлечения</h2>
      <p class="u-muted">
        Рейтинг складывается из CAC, ROMI, LTV:CAC и числа новых клиентов. Целевые CAC и ROMI заданы в BYN и
        процентах. Архивный канал остаётся в истории и отчётах, но новые кампании по нему создать нельзя.
      </p>
    </div>

    <div class="toolbar">
      <form class="filter-bar" method="get" action="<%= filterControl.action %>" aria-label="Фильтры каналов">
        <% for (const field of filterControl.hiddenFields) { %>
        <input type="hidden" name="<%= field.name %>" value="<%= field.value %>">
        <% } %>

        <label class="field">
          <span class="field__label">Статус</span>
          <select class="select" name="status">
            <option value="all" <%= filters.status === 'all' ? 'selected' : '' %>>Все</option>
            <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>Активные</option>
            <option value="archived" <%= filters.status === 'archived' ? 'selected' : '' %>>В архиве</option>
          </select>
        </label>

        <label class="field">
          <span class="field__label">Тип</span>
          <select class="select" name="kind">
            <option value="all" <%= filters.kind === 'all' ? 'selected' : '' %>>Все типы</option>
            <option value="paid" <%= filters.kind === 'paid' ? 'selected' : '' %>>Платные</option>
            <option value="owned" <%= filters.kind === 'owned' ? 'selected' : '' %>>Собственные</option>
            <option value="earned" <%= filters.kind === 'earned' ? 'selected' : '' %>>Заработанные</option>
          </select>
        </label>

        <button class="btn btn--ghost btn--sm" type="submit">Показать</button>
        <% if (filters.active) { %>
        <a class="btn btn--ghost btn--sm" href="<%= filters.resetHref %>">Сбросить фильтры</a>
        <% } %>
      </form>

      <% if (can('export')) { %>
      <form method="get" action="/app/export/channels.csv" aria-label="Экспорт каналов в CSV">
        <input type="hidden" name="status" value="<%= filters.status %>">
        <input type="hidden" name="kind" value="<%= filters.kind %>">
        <button class="btn btn--ghost btn--sm" type="submit">Экспорт CSV</button>
      </form>
      <% } %>
    </div>

    <% if (can('channels:view') && locals.weightsControl) { %>
    <div class="card card--flat">
      <div class="card__header">
        <div>
          <h3 class="card__title">Веса рейтинга</h3>
          <p class="card__meta">
            Четыре числа от 0 до 100, можно с десятыми. Сервер нормализует их к сумме 100, поэтому важны пропорции,
            а не абсолютные значения. Рейтинг доступен всем ролям и меняется только в адресе страницы.
          </p>
        </div>
      </div>

      <form class="inline-form" method="get" action="<%= weightsControl.action %>" aria-label="Веса рейтинга каналов">
        <% for (const field of weightsControl.hiddenFields) { %>
        <input type="hidden" name="<%= field.name %>" value="<%= field.value %>">
        <% } %>

        <% for (const field of weightsControl.fields) { %>
        <label class="field">
          <span class="field__label"><%= field.label %></span>
          <input
            class="input"
            type="number"
            name="<%= field.name %>"
            value="<%= field.value %>"
            min="0"
            max="100"
            step="any"
            inputmode="decimal"
            required
          >
          <span class="field__hint"><%= field.hint %></span>
        </label>
        <% } %>

        <div class="cluster">
          <button class="btn btn--ghost" type="submit">Пересчитать рейтинг</button>
          <a class="btn btn--ghost" href="<%= weightsControl.resetHref %>">Веса по умолчанию</a>
        </div>
      </form>
    </div>
    <% } %>

    <% if (can('channels:manage')) { %>
    <div class="card card--flat">
      <div class="card__header">
        <div>
          <h3 class="card__title">Новый канал</h3>
          <p class="card__meta">Код задаётся один раз: по нему кампании и импорт связываются с каналом.</p>
        </div>
      </div>

      <% if (createError) { %>
      <div class="alert alert--error" role="alert" id="channel-create-error">
        <p class="alert__title">Канал не создан</p>
        <%= createError %>
      </div>
      <% } %>

      <form class="inline-form" method="post" action="/app/channels">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <label class="field">
          <span class="field__label">Код</span>
          <input
            class="input"
            type="text"
            name="code"
            value="<%= createValues.code %>"
            placeholder="viber_ads"
            maxlength="40"
            autocomplete="off"
            required
            <% if (createError) { %>aria-invalid="true" aria-describedby="channel-create-error"<% } %>
          >
          <span class="field__hint">Строчные латинские буквы, цифры и подчёркивание</span>
        </label>

        <label class="field">
          <span class="field__label">Название</span>
          <input
            class="input"
            type="text"
            name="name"
            value="<%= createValues.name %>"
            placeholder="Viber Ads"
            maxlength="100"
            autocomplete="off"
            required
            <% if (createError) { %>aria-invalid="true" aria-describedby="channel-create-error"<% } %>
          >
        </label>

        <label class="field">
          <span class="field__label">Тип</span>
          <select
            class="select"
            name="kind"
            <% if (createError) { %>aria-invalid="true" aria-describedby="channel-create-error"<% } %>
          >
            <option value="paid" <%= createValues.kind === 'paid' ? 'selected' : '' %>>Платный</option>
            <option value="owned" <%= createValues.kind === 'owned' ? 'selected' : '' %>>Собственный</option>
            <option value="earned" <%= createValues.kind === 'earned' ? 'selected' : '' %>>Заработанный</option>
          </select>
        </label>

        <label class="field">
          <span class="field__label">Целевой CAC</span>
          <input
            class="input"
            type="text"
            name="targetCacByn"
            value="<%= createValues.targetCacByn %>"
            placeholder="38,50"
            inputmode="decimal"
            autocomplete="off"
            <% if (createError) { %>aria-invalid="true" aria-describedby="channel-create-error"<% } %>
          >
          <span class="field__hint">В BYN, можно оставить пустым</span>
        </label>

        <label class="field">
          <span class="field__label">Целевой ROMI</span>
          <input
            class="input"
            type="text"
            name="targetRomiPct"
            value="<%= createValues.targetRomiPct %>"
            placeholder="115"
            inputmode="decimal"
            autocomplete="off"
            <% if (createError) { %>aria-invalid="true" aria-describedby="channel-create-error"<% } %>
          >
          <span class="field__hint">В процентах, от 0 до 10 000</span>
        </label>

        <div class="cluster">
          <button class="btn btn--primary" type="submit">Добавить канал</button>
        </div>
      </form>
    </div>
    <% } %>

    <%- include('../partials/island', { name: 'channels', model }) %>
  </div>
</section>
