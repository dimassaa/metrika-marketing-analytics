<%#
  Dashboard frame. The page owns the shell, the channel filter and the single island mount node; KPI tiles, the
  verdict and all charts are rendered by `client/entries/dashboard.jsx` from `model` (the same object
  `/api/v1/dashboard` returns).

  The filter is a plain GET form so the URL remains the only state and the screen works without JavaScript. An empty
  multi-select submits no `channelIds`, which the schema treats as "all channels" — the same value as an absent
  parameter, never as an empty filter that would silently widen the report.
%>
<section class="app-section">
  <div class="stack stack--lg">
    <% if (locals.filterControl && filterControl.options.length > 0) { %>
    <form class="card filters" method="get" action="<%= filterControl.action %>" aria-label="Фильтр по каналам">
      <%# Replay the period exactly as the request used it: `days` or an explicit `from`/`to` pair, never both. %>
      <% for (const field of filterControl.periodFields) { %>
      <input type="hidden" name="<%= field.name %>" value="<%= field.value %>">
      <% } %>

      <div class="filters__field">
        <label class="filters__label" for="dashboard-channels">Каналы</label>
        <select
          class="select filters__select"
          id="dashboard-channels"
          name="channelIds"
          multiple
          size="<%= filterControl.size %>"
          aria-describedby="dashboard-channels-hint"
        >
          <% for (const option of filterControl.options) { %>
          <option value="<%= option.value %>"<%= option.selected ? ' selected' : '' %>><%= option.label %></option>
          <% } %>
        </select>
        <p class="filters__hint" id="dashboard-channels-hint">
          <% if (filterControl.active) { %>Выбрано <%= filterControl.selectedCount %> из <%= filterControl.total %>.
          <% } else { %>Ничего не выбрано — все каналы. <% } %>Несколько значений: Ctrl или ⌘.
        </p>
      </div>

      <div class="filters__actions">
        <button class="btn btn--ghost btn--sm" type="submit">Применить</button>
        <% if (filterControl.active) { %>
        <a class="btn btn--ghost btn--sm" href="<%= filterControl.resetHref %>">Сбросить</a>
        <% } %>
      </div>
    </form>
    <% } %>

    <%- include('../partials/island', { name: 'dashboard', model }) %>
  </div>
</section>
