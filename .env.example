# Copy this file to .env and adjust the connection strings for your machine.
# Nothing here is tied to the author's setup.

NODE_ENV=development
PORT=3000

# Local PostgreSQL with the default Docker credentials:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/metrika_dev
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/metrika_test

# Used only by `npm run db:setup` to create the two databases above.
# Use a role that can connect to the `postgres` database. Grant CREATEDB if the
# databases do not exist yet; otherwise pre-create them with `createdb`.
# `postgres:///postgres` leaves the host unset: node-postgres falls back to TCP
# localhost, or to a Unix socket when PGHOST is exported. Under peer auth the
# role must match the OS user and the password is ignored. For a socket-only
# server, create the databases with `createdb` and skip `db:setup`, or add
# `?host=/var/run/postgresql` to the URL.
ADMIN_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Generate with (works on Windows, macOS and Linux):
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# or with OpenSSL: openssl rand -hex 32
SESSION_SECRET=replace-with-a-random-32-byte-hex-string

APP_URL=http://localhost:3000
# true only behind HTTPS in production
COOKIE_SECURE=false

# Boolean flags accept exactly `true` or `false`; `0`, `1` and `yes` are rejected at boot.
# The Docker compose stand is the only place that sets the demo exception: production with
# `COOKIE_SECURE=false` boots only when `DEMO_INSECURE_COOKIES=true` and APP_URL is an exact
# loopback host (`localhost`, `127.0.0.1`, `[::1]`). Never enable it on a public stand.
DEMO_INSECURE_COOKIES=false
# Read by docker/entrypoint.sh only: apply migrations and seed the demo dataset when all three
# guard tables (users, channels, daily_stats) are empty.
RUN_MIGRATIONS=true
AUTO_SEED_DEMO=false

# Backups (M6). The key belongs in a file with 0600 permissions, not in an environment
# variable, because env values leak through `docker inspect` and shell history.
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# then save it as the file below and run `chmod 600` (Windows: see docs/deployment.md §5).
# BACKUP_KEY_FILE=./backups/backup.key
# BACKUP_DIR=./backups
# BACKUP_RETENTION_DAYS=7
# RESTORE_TMP_DIR=./tmp
# Only for a native CLI run without a key file; never set it in Compose.
# BACKUP_KEY=
# Override when pg_dump/pg_restore are not first in PATH (paths differ on Windows).
# PG_DUMP=/usr/lib/postgresql/18/bin/pg_dump
# PG_RESTORE=/usr/lib/postgresql/18/bin/pg_restore

# How many reverse-proxy hops may set X-Forwarded-For. Keep false unless a proxy
# sits in front: a directly reachable app would otherwise trust a forged header
# for the audit IP and the login limiter. Use 1 behind a single proxy, or a
# subnet list such as "loopback, 10.0.0.0/8". true trusts every hop.
TRUST_PROXY=false

LOG_LEVEL=info
